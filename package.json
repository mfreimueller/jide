{
  "name": "jide",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal Java IDE for beginners",
  "workspaces": [
    "shared",
    "java-helper",
    "app",
    "backend",
    "teacher"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke -w app",
    "test:e2e": "npm run test:e2e -w app"
  }
}
