{
  "name": "@jide/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "teacher:add": "tsx --env-file-if-exists=.env src/scripts/add_teacher.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@jide/shared": "^0.1.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
