{
  "name": "@jide/app",
  "version": "0.6.0",
  "private": true,
  "productName": "JDE",
  "description": "J;DE Electron app",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test:e2e": "electron-vite build && playwright test",
    "runtime": "node scripts/build-runtime.mjs",
    "verify-runtime": "node scripts/verify-runtime.mjs",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:exam": "electron-vite build && electron-builder --config electron-builder.exam.yml --win dir --x64 --publish never",
    "dist:publish": "electron-vite build && electron-builder --win nsis --x64 --publish always",
    "dist:mac": "node -e \"if(!process.env.JIDE_API_URL){console.error('JIDE_API_URL is not set. The URL is compiled into the app, e.g.: JIDE_API_URL=https://jide.example.org npm run dist:mac');process.exit(1)}\" && node scripts/build-runtime.mjs build/jdk-mac && electron-vite build && electron-builder --config electron-builder.mac.yml --mac dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "monaco-editor": "^0.57.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Michael Freimüller"
}
